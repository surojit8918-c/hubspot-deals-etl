# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=dev-secret-key-change-in-production
PORT=5200
HOST=0.0.0.0

# Database (development only)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hubspot_deals_data_dev
DB_USER=postgres
DB_PASSWORD=password123
DB_SCHEMA=hubspot_deals_dev

# DLT
DLT_PIPELINE_NAME=hubspot_deals_pipeline_dev
DLT_WORKING_DIR=.dlt

# HubSpot API
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_TIMEOUT=30
HUBSPOT_API_RATE_LIMIT=150          # requests per 10 seconds
HUBSPOT_RATE_LIMIT_WINDOW_SECONDS=10
HUBSPOT_API_MAX_RETRIES=3
HUBSPOT_API_RETRY_BACKOFF_SECONDS=1
HUBSPOT_PAGE_SIZE=100               # max 100
HUBSPOT_TEST_DELAY_SECONDS=0        # artificial per-page delay for pause/resume tests only

# Extraction
CHECKPOINT_EVERY_N_PAGES=10
MAX_PAGES=1000
MAX_CONCURRENT_SCANS=3
SCAN_TIMEOUT_HOURS=24
CLEANUP_DAYS=7

# Logging
LOG_LEVEL=INFO
LOKI_ENABLED=false

# Local testing only (read by scripts/e2e_test.py, never by the service). Leave blank in .env.example.
HUBSPOT_ACCESS_TOKEN=